    "fallback": "explicit_named_default_for_unselected_tasks_empty_provider_fallbacks",
    "rules": [
      "ARS子任务使用ars-paper role-brief生成的goal/context/option；角色、席位和合同保留在context中，模型由Hermes官方Model routes选择。",
      "正式派发前显式运行ars-paper role-check校验任务包；此检查不是model_map运行时拦截，不能声称所有直接调用均受ARS硬校验。",
      "本地非ARS扩展可直接显式使用option；未选路由使用Hermes中配置的具名默认路由，六条路由显式禁用供应商回退。",
      "同模型多角色不等于跨模型验证；独立执行、冻结材料和评审准确性分别说明。",
      "子任务返回候选与证据，正式Paper写回由主会话负责；工具和文件范围不构成操作系统沙箱。",
      "角色配置不是实际研究授权，不自动启用数据库写入、外部供应商或实验执行。"
    ],
    "role_registry": "项目管理/Hermes学术助手配置/ARS融合/角色路由.json"
  },
  "execution_policy": {
    "cross_model_default": "off_requires_provider_and_content_consent",
    "database_default": "no_implicit_write",
    "experiment_bridge": "only_explicit_user_authorized_task_outside_ars_pipeline",
    "paper_write": "mac-paper_current_sha_or_expect_missing",
    "research_decisions": "user_owned_no_inferred_confirmation",
    "small_tasks": "no_mandatory_passport_or_full_pipeline",
    "paper_reading": "reuse_or_persist_partial_card_before_reading_update_actual_scope_then_downstream_no_duplicate_or_bulk_backfill",
    "long_runs": "use_real_ars_passport_and_run_ledger_in_task_owner_not_parallel_research_state",
    "review_fallback": "only_workflow_permitted_single_context_mode_otherwise_block_required_independent_stage"
  },
