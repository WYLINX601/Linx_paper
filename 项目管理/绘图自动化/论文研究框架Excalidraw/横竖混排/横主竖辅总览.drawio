        <mxCell id="5noQqHyP" parent="jpTKNi7E" vertex="1" value="类型组合与空间关系是并列线索；经比较、证据回查与反例检验形成解释，不画成简单因果链。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
