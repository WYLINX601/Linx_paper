          <mxGeometry as="geometry" x="12" y="185.9000000000001" width="482" height="20.4" />
        </mxCell>
        <mxCell id="LwFcT23X" parent="1" vertex="1" value="景宁畲族传统民居风貌研究框架" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=34;fontColor=#202020;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
