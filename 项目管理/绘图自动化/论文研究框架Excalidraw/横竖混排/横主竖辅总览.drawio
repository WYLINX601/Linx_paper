        </mxCell>
        <mxCell id="5EUVkmci" parent="vf2wh1Xu" vertex="1" value="这是条件性空间映射规则，不是全部图谱事实&lt;br&gt;或分析的共同门槛。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
