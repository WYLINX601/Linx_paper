        </mxCell>
        <mxCell id="hnuUHVhd" parent="38lyOVN2" vertex="1" value="交代通用基础，不提前展开本研究的具体模型或实例结果&lt;br&gt;。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
