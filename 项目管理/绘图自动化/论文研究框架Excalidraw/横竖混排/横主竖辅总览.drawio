        </mxCell>
        <mxCell id="8wFUiZ27" parent="2xv8Bu9v" vertex="1" value="总体结构先统一对象及其知识组织；不是只列&lt;br&gt;两种关联名称。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
