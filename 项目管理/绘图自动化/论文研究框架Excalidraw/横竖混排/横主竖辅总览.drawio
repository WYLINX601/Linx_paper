        <mxCell id="kEcZUoyl" parent="G8XP8eMU" vertex="1" value="研究推进与论文呈现相互对应，但不混为同&lt;br&gt;一层级。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
