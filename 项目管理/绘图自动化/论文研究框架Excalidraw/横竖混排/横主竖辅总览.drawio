        <mxCell id="zqzkrZFh" parent="B1XTSyp7" vertex="1" value="质量要求贯穿实例化，不被画成最后才执行&lt;br&gt;的一步。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
          <mxGeometry as="geometry" x="12" y="279.7999999999997" width="306" height="38.8" />
        </mxCell>
        <mxCell id="mkqRXzI1" parent="Axq1AJyJ" vertex="1" value="讨论判别与记录规则，不在第三章预写景宁民&lt;br&gt;居的真实类型发现。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
          <mxGeometry as="geometry" x="12" y="362.39999999999986" width="322" height="38.8" />
        </mxCell>
        <mxCell id="tLFVko47" parent="IE8WfhnV" vertex="1" value="组合、变体与跨尺度比较是方法单元；关联与&lt;br&gt;共现不直接推出成因。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
