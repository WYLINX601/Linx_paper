        </mxCell>
        <mxCell id="M9qJYMOs" parent="1" vertex="1" value="横向主任务 · 竖向短概念 · 横向交付条" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#202020;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
          <mxGeometry as="geometry" x="892.36" y="61.35" width="381.28" height="27.299999999999997" />
        </mxCell>
        <mxCell id="EZaft9El" parent="1" vertex="1" value="图注：3.2的特征判据与3.3的统一定义共同支撑3.4；不要求先完成建库或全部三维关联。&lt;br&gt;本图表达研究任务和论证关系，不表示正文、真实样本、方法有效性或实证结论已经完成。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#555555;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
          <mxGeometry as="geometry" x="722.0" y="3451.400000000001" width="722" height="43.4" />
        </mxCell>
        <mxCell id="X9VHc5OW" parent="1" vertex="1" value="版式：章标题与主任务横排；短概念竖排展开；横向汇总条标示章末交付。&lt;br&gt;读图：外框表示包含；同组未连箭头的卡片为并列单元；实线箭头按标注表示支撑、约束或论证推进。&lt;br&gt;虚线箭头仅表示问题或反例反馈。章、节标题是分组，不作为另一个末端概念；未实施事项不因入图变成既有成果。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#555555;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
          <mxGeometry as="geometry" x="128" y="108.95" width="920" height="64.1" />
        </mxCell>
      </root>
