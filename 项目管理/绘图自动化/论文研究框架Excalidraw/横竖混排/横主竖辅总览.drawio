        <mxCell id="c0l2XhOo" parent="SAJHamNh" vertex="1" value="实例组织与空间映射分别实施；不能把缺少三维对应的非空间&lt;br&gt;事实一概排除。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
