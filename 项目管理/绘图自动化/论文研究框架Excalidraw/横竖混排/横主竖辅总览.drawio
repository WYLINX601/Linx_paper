        <mxCell id="dIEaWH8g" parent="l8pzkptl" vertex="1" value="地域文化用于有据解释，不由外观直接推定文化成因。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
