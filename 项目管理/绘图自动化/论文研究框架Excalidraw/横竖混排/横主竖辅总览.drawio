        </mxCell>
        <mxCell id="hx16abE7" parent="imC8Hx86" vertex="1" value="列入比较不等于采用；感知仅作理论背景，文化解释有据才用&lt;br&gt;。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
