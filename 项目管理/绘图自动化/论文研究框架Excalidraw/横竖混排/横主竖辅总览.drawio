        <mxCell id="uvVvtKHi" parent="SCLimGXI" vertex="1" value="正式样本和分析单元依实际资料核查确定，不预设数量&lt;br&gt;或代表性。" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#565656;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;">
          <mxGeometry as="geometry" x="12" y="210.60000000000014" width="386" height="38.8" />
