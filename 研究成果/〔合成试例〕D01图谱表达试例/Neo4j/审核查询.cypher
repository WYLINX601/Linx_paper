// D01V01 v1.1 实际执行的审核查询；每段分别运行；全部人工合成。
// Q00 局部图显示
MATCH (a:D01V01)-[r]->(b:D01V01) RETURN a,r,b;

// Q01 民居组成
MATCH (u:D01V01:DwellingUnit)-[r:BOT_HAS_BUILDING|BOT_HAS_SPACE]->(x:D01V01)
RETURN u.name AS unit,x.id AS id,x.name AS object,type(r) AS relation,x.botClassIri AS botClass,r.botPropertyIri AS botProperty ORDER BY id;

// Q02 对象直接保存水平尺度与比例
MATCH (b:D01V01:Building)-[r:USES_DATUM]->(d:D01V01:ReferenceDatum)
WHERE b.geometryActive=true AND b.scenario='T0' AND b.geometryVersion='v1'
RETURN b.id AS id,b.name AS building,b.widthM AS widthM,b.depthM AS depthM,
CASE WHEN b.unit='m' AND d.unit='m' AND b.widthM>0 AND b.depthM>0 AND all(f IN ['widthM','depthM'] WHERE f IN r.fields) THEN b.widthM/b.depthM END AS widthDepthRatio,
b.widthDirection AS widthDirection,b.depthDirection AS depthDirection,b.measurementBoundaryBasis AS boundary,d.id AS datum ORDER BY id;

// Q03 直接从建筑计算自身高度与高宽比
MATCH (b:D01V01:Building)-[r:USES_DATUM]->(d:D01V01:ReferenceDatum)
WHERE b.geometryActive=true AND b.scenario='T0' AND b.geometryVersion='v1'
WITH b,d,r,CASE WHEN b.unit='m' AND d.unit='m' AND b.eaveZM IS NOT NULL AND b.groundZM IS NOT NULL AND all(f IN ['eaveZM','groundZM'] WHERE f IN r.fields) THEN b.eaveZM-b.groundZM END AS h
RETURN b.id AS id,b.name AS building,b.groundZM AS groundZM,b.eaveZM AS eaveZM,h AS ownEaveHeightM,
CASE WHEN b.widthM>0 AND 'widthM' IN r.fields THEN h/b.widthM END AS eaveWidthRatio,b.heightBasis AS basis,d.id AS datum ORDER BY id;

// Q04 对象属性比较与保存结果重算
MATCH (c:D01V01:ComparisonResult)-[be:COMPARES_SUBJECT]->(b:D01V01:Building),
(c)-[ae:COMPARES_REFERENCE]->(a:D01V01:Building),(c)-[:APPLIES_RULE]->(rule:D01V01:AnalysisRule)
OPTIONAL MATCH (b)-[bd:USES_DATUM]->(db:D01V01:ReferenceDatum)
OPTIONAL MATCH (a)-[ad:USES_DATUM]->(da:D01V01:ReferenceDatum)
OPTIONAL MATCH (b)-[bs:HAS_SOURCE]->(esb:D01V01:Source) WHERE bs.uid=be.sourceRelationUid
OPTIONAL MATCH (a)-[asrc:HAS_SOURCE]->(esa:D01V01:Source) WHERE asrc.uid=ae.sourceRelationUid
WITH c,b,a,db,da,rule,{a:{value:a[ae.field],field:ae.field,role:ae.role,unit:a.unit,datumUnit:da.unit,datum:da.uid,scenario:a.scenario,geometryVersion:a.geometryVersion,requiredGeometryVersion:ae.geometryVersion,sourceVersion:asrc.sourceVersion,requiredSourceVersion:esa.sourceVersion,expectedSourceVersion:ae.sourceVersion,sourceRelationUid:asrc.uid,requiredSourceRelationUid:ae.sourceRelationUid,sourceFields:asrc.fields,datumFields:ad.fields,locator:asrc.locator},b:{value:b[be.field],field:be.field,role:be.role,unit:b.unit,datumUnit:db.unit,datum:db.uid,scenario:b.scenario,geometryVersion:b.geometryVersion,requiredGeometryVersion:be.geometryVersion,sourceVersion:bs.sourceVersion,requiredSourceVersion:esb.sourceVersion,expectedSourceVersion:be.sourceVersion,sourceRelationUid:bs.uid,requiredSourceRelationUid:be.sourceRelationUid,sourceFields:bs.fields,datumFields:bd.fields,locator:bs.locator},scenario:c.scenario} AS t
WITH c,b,a,db,da,rule,t,CASE
 WHEN t.a.value IS NULL OR t.b.value IS NULL THEN '不可判定：缺少檐口高程'
 WHEN coalesce(t.a.field,'')<>'eaveZM' OR coalesce(t.b.field,'')<>'eaveZM' OR coalesce(t.a.role,'')<>'subtrahend' OR coalesce(t.b.role,'')<>'minuend' THEN '不可判定：字段或角色不符'
 WHEN coalesce(t.a.unit,'')<>'m' OR coalesce(t.b.unit,'')<>'m' OR coalesce(t.a.datumUnit,'')<>'m' OR coalesce(t.b.datumUnit,'')<>'m' THEN '不可判定：单位未统一'
 WHEN t.a.datum IS NULL OR t.b.datum IS NULL OR t.a.datum<>t.b.datum THEN '不可判定：基准不一致'
 WHEN t.a.scenario IS NULL OR t.b.scenario IS NULL OR t.a.scenario<>t.b.scenario OR t.scenario IS NULL OR t.scenario<>t.a.scenario THEN '不可判定：情境不一致'
 WHEN t.a.geometryVersion IS NULL OR t.b.geometryVersion IS NULL OR t.a.requiredGeometryVersion IS NULL OR t.b.requiredGeometryVersion IS NULL OR t.a.geometryVersion<>t.a.requiredGeometryVersion OR t.b.geometryVersion<>t.b.requiredGeometryVersion THEN '不可判定：几何版本不符'
 WHEN t.a.sourceVersion IS NULL OR t.b.sourceVersion IS NULL OR t.a.requiredSourceVersion IS NULL OR t.b.requiredSourceVersion IS NULL OR t.a.expectedSourceVersion IS NULL OR t.b.expectedSourceVersion IS NULL OR t.a.sourceVersion<>t.a.requiredSourceVersion OR t.b.sourceVersion<>t.b.requiredSourceVersion OR t.a.sourceVersion<>t.a.expectedSourceVersion OR t.b.sourceVersion<>t.b.expectedSourceVersion THEN '不可判定：来源版本不符'
 WHEN t.a.sourceRelationUid IS NULL OR t.b.sourceRelationUid IS NULL OR t.a.requiredSourceRelationUid IS NULL OR t.b.requiredSourceRelationUid IS NULL OR t.a.sourceRelationUid<>t.a.requiredSourceRelationUid OR t.b.sourceRelationUid<>t.b.requiredSourceRelationUid THEN '不可判定：来源关系不符'
 WHEN NOT(t.a.field IN coalesce(t.a.sourceFields,[])) OR NOT(t.b.field IN coalesce(t.b.sourceFields,[])) THEN '不可判定：来源未支持该字段'
 WHEN NOT(t.a.field IN coalesce(t.a.datumFields,[])) OR NOT(t.b.field IN coalesce(t.b.datumFields,[])) THEN '不可判定：基准未覆盖该字段'
 WHEN coalesce(t.a.locator,'')='' OR coalesce(t.b.locator,'')='' THEN '不可判定：缺少来源定位'
 ELSE '可计算' END AS status
WITH c,b,a,db,da,rule,status,CASE WHEN status='可计算' THEN t.b.value-t.a.value END AS delta
RETURN b.name AS subject,a.name AS reference,delta AS recomputedM,c.valueM AS storedM,status,CASE WHEN delta IS NULL THEN '不可判定' WHEN abs(delta-c.valueM)<1e-9 THEN '保存结果与输入一致' ELSE '结果过期，需重算' END AS checkStatus,rule.ruleId AS rule,da.id AS referenceDatum,db.id AS subjectDatum;

// Q05 比较到对象属性与字段来源的追溯
MATCH (c:D01V01:ComparisonResult)-[input:COMPARES_SUBJECT|COMPARES_REFERENCE]->(b:D01V01:Building)-[s:HAS_SOURCE]->(e:D01V01:Source),
(b)-[:USES_DATUM]->(d:D01V01:ReferenceDatum),(c)-[:APPLIES_RULE]->(rule:D01V01:AnalysisRule)
WHERE input.sourceRelationUid=s.uid AND input.field IN s.fields
RETURN c.id AS result,input.role AS role,input.field AS field,b.id AS inputObject,b[input.field] AS inputValue,b.unit AS unit,b.scenario AS scenario,b.geometryVersion AS inputVersion,d.id AS datum,
e.name AS evidence,e.sourceKind AS evidenceKind,e.sourcePath AS sourcePath,s.sourceVersion AS sourceVersion,input.geometryVersion AS expectedGeometryVersion,input.sourceVersion AS expectedSourceVersion,e.sourceVersion AS currentSourceVersion,
(b.geometryVersion=input.geometryVersion AND s.sourceVersion=input.sourceVersion AND e.sourceVersion=input.sourceVersion) AS versionsMatch,
'仅为追溯展示；完整计算前提见Q04' AS traceBoundary,s.locator AS locator,s.fields AS supportedFields,rule.ruleId AS rule,rule.expression AS expression ORDER BY role;

// Q06 取消记录节点与BOT类别边界
MATCH (n:D01V01)
RETURN count(n) AS nodes,sum(CASE WHEN n:Building THEN 1 ELSE 0 END) AS buildings,sum(CASE WHEN n:Space THEN 1 ELSE 0 END) AS spaces,
sum(CASE WHEN n:MeasurementSet THEN 1 ELSE 0 END) AS inputRecords,sum(CASE WHEN n:Source THEN 1 ELSE 0 END) AS sources,
sum(CASE WHEN n:Building AND n:Space THEN 1 ELSE 0 END) AS disjointClassConflicts,sum(CASE WHEN n.dataMode<>'synthetic' OR n.dataMode IS NULL THEN 1 ELSE 0 END) AS unmarkedSyntheticNodes;

// Q07 缺失与不可比输入反例（只读参数，不写库）
// 所需参数JSON：{"fixtures": [{"name": "01_共同基准", "a": {"eaveZM": 5.0, "unit": "m", "datum": "D01", "scenario": "T0"}, "b": {"eaveZM": 7.0, "unit": "m", "datum": "D01", "scenario": "T0"}}, {"name": "02_基准不同", "a": {"eaveZM": 5.0, "unit": "m", "datum": "D01", "scenario": "T0"}, "b": {"eaveZM": 7.0, "unit": "m", "datum": "D02", "scenario": "T0"}}, {"name": "03_高程缺失", "a": {"eaveZM": 5.0, "unit": "m", "datum": "D01", "scenario": "T0"}, "b": {"eaveZM": null, "unit": "m", "datum": "D01", "scenario": "T0"}}, {"name": "04_单位不同", "a": {"eaveZM": 5.0, "unit": "m", "datum": "D01", "scenario": "T0"}, "b": {"eaveZM": 7.0, "unit": "cm", "datum": "D01", "scenario": "T0"}}, {"name": "05_情境不同", "a": {"eaveZM": 5.0, "unit": "m", "datum": "D01", "scenario": "T0"}, "b": {"eaveZM": 7.0, "unit": "m", "datum": "D01", "scenario": "T1"}}]}
UNWIND $fixtures AS t
WITH t,CASE
 WHEN t.a.eaveZM IS NULL OR t.b.eaveZM IS NULL THEN '不可判定：缺少檐口高程'
 WHEN coalesce(t.a.unit,'')<>'m' OR coalesce(t.b.unit,'')<>'m' THEN '不可判定：单位未统一'
 WHEN t.a.datum IS NULL OR t.b.datum IS NULL OR t.a.datum<>t.b.datum THEN '不可判定：基准不一致'
 WHEN t.a.scenario IS NULL OR t.b.scenario IS NULL OR t.a.scenario<>t.b.scenario THEN '不可判定：情境不一致'
 ELSE '可计算' END AS status
RETURN t.name AS fixture,status,CASE WHEN status='可计算' THEN t.b.eaveZM-t.a.eaveZM END AS deltaM ORDER BY fixture;

// Q08 比例分母反例（只读参数，不写库）
// 所需参数JSON：{"fixtures": [{"name": "01_正常", "width": 10.0, "depth": 6.0}, {"name": "02_零分母", "width": 10.0, "depth": 0.0}, {"name": "03_缺失", "width": 10.0, "depth": null}]}
UNWIND $fixtures AS t
RETURN t.name AS fixture,
CASE WHEN t.width IS NULL OR t.depth IS NULL THEN '不可判定：输入缺失'
 WHEN t.width<=0 OR t.depth<=0 THEN '不可判定：尺寸非正'
 ELSE '可计算' END AS status,
CASE WHEN t.width>0 AND t.depth>0 THEN t.width/t.depth END AS ratio ORDER BY fixture;

// Q09 从共享来源反查对象和支持字段
MATCH (b:D01V01)-[s:HAS_SOURCE]->(e:D01V01:Source {id:'EV01'})
RETURN e.id AS sourceId,b.id AS objectId,b.name AS object,s.fields AS fields,s.locator AS locator,s.sourceVersion AS sourceVersion,s.evidenceRole AS evidenceRole,s.reviewStatus AS reviewStatus ORDER BY objectId;

// Q10 共用Q04保护逻辑的字段、版本与缺失反例（只读参数）
// 所需参数JSON：{"fixtures": [{"name": "01_正常", "a": {"value": 5.0, "field": "eaveZM", "role": "subtrahend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E011", "requiredSourceRelationUid": "D01V01:E011", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/2/properties"}, "b": {"value": 7.0, "field": "eaveZM", "role": "minuend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E014", "requiredSourceRelationUid": "D01V01:E014", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/3/properties"}, "scenario": "T0", "storedM": 2.0}, {"name": "02_来源未覆盖字段", "a": {"value": 5.0, "field": "eaveZM", "role": "subtrahend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E011", "requiredSourceRelationUid": "D01V01:E011", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/2/properties"}, "b": {"value": 7.0, "field": "eaveZM", "role": "minuend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E014", "requiredSourceRelationUid": "D01V01:E014", "sourceFields": ["widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/3/properties"}, "scenario": "T0", "storedM": 2.0}, {"name": "03_几何版本变化", "a": {"value": 5.0, "field": "eaveZM", "role": "subtrahend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E011", "requiredSourceRelationUid": "D01V01:E011", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/2/properties"}, "b": {"value": 7.0, "field": "eaveZM", "role": "minuend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v2", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E014", "requiredSourceRelationUid": "D01V01:E014", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/3/properties"}, "scenario": "T0", "storedM": 2.0}, {"name": "04_来源版本变化", "a": {"value": 5.0, "field": "eaveZM", "role": "subtrahend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E011", "requiredSourceRelationUid": "D01V01:E011", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/2/properties"}, "b": {"value": 7.0, "field": "eaveZM", "role": "minuend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "2.0", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E014", "requiredSourceRelationUid": "D01V01:E014", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/3/properties"}, "scenario": "T0", "storedM": 2.0}, {"name": "05_来源关系缺失", "a": {"value": 5.0, "field": "eaveZM", "role": "subtrahend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": "D01V01:E011", "requiredSourceRelationUid": "D01V01:E011", "sourceFields": ["analysisItems", "depthDirection", "depthM", "eavePointXYZ", "eaveZM", "footprintShape", "footprintXY", "geometryActive", "geometryVersion", "groundPointXYZ", "groundZM", "heightBasis", "measurementBoundaryBasis", "precisionMeaning", "ridgePointXYZ", "ridgeZM", "scenario", "unit", "widthDirection", "widthM"], "datumFields": ["depthM", "eavePointXYZ", "eaveZM", "footprintXY", "groundPointXYZ", "groundZM", "ridgePointXYZ", "ridgeZM", "widthM"], "locator": "/nodes/2/properties"}, "b": {"value": 7.0, "field": "eaveZM", "role": "minuend", "unit": "m", "datumUnit": "m", "datum": "D01V01:D01", "scenario": "T0", "geometryVersion": "v1", "requiredGeometryVersion": "v1", "sourceVersion": "1.1", "requiredSourceVersion": "1.1", "expectedSourceVersion": "1.1", "sourceRelationUid": null, "requiredSourc