        <mxCell id="22" value="实例依据：E_DEMO&lt;br&gt;人工设定的教学场景&lt;br&gt;&lt;br&gt;模型依据：BOT03、ISM03&lt;br&gt;文献支持表达方法，&lt;br&gt;不证明此场景是实际住宅。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontColor=#172b4d;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1">
