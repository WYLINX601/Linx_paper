        <mxCell id="21" value="ACCESS_HV&lt;br&gt;&lt;br&gt;起点：S_HALL 堂屋&lt;br&gt;关系：direct_access_to&lt;br&gt;终点：S_VERANDA 前廊&lt;br&gt;经过界面：I_OPEN&lt;br&gt;使用者：可独立行走的成人&lt;br&gt;方式：普通步行&lt;br&gt;时段：演示正常使用时段" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontColor=#172b4d;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;" vertex="1" parent="1">
