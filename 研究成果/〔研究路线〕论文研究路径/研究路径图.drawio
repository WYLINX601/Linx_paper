  <diagram name="当前目标与拟开展路径">
    <mxGraphModel dx="1520" dy="1520" grid="1" gridSize="10" page="1" pageWidth="1520" pageHeight="1520" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;传统民居风貌语义描述与三维空间关联研究路径&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=34;fontColor=#243746;align=center;verticalAlign=middle;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;shape=label;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="以景宁畲族传统民居建筑及其聚居风貌为核心研究对象，构建多尺度语义描述模型，建立风貌对象、特征及关系与三维空间区域之间的关联方法，并通过案例标注、空间查询与风貌比较分析验证其有效性。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=23;fontColor=#243746;align=center;verticalAlign=middle;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="190" y="100" width="1270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="head1" value="对象已聚焦传统民居；下列方法与验证为拟开展（非新章节目录）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#243746;align=center;verticalAlign=middle;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;shape=label;fillColor=none;strokeColor=none;" vertex="1" parent="1">
