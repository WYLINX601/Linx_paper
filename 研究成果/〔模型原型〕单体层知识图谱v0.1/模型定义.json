    "attribution": [
      "author_report",
      "reader_diagram_observation",
      "reader_modeling_inference",
      "author_interpretation"
    ],
    "status": [
      "documented",
      "tentative",
      "disputed"
    ],
    "temporalScope": "原文所述/图示时点；日期未知须明确，不以论文出版年或录入日期替代测绘年。",
    "evidence": "至少一条Evidence ID。证据包含Zotero key、PDF页序、印刷页及图表/行定位。",
    "numericRules": "数值量须有单位、对象边界、测量/计算方法；计数仍需范围。",
    "conflictRule": "相互矛盾的断言并存并标记disputed；不取平均、不覆盖、不按年份自动择新。",
    "unknownRule": "未记载不生成假值；另在gaps中列unknown/not_observed/not_applicable，false需明确否定证据。"
  },
  "classificationContract": {
    "required": [
