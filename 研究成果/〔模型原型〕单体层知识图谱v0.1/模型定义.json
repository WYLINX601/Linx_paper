{
  "version": "0.1",
  "status": "discussion_draft",
  "created": "2026-10-22",
  "purpose": "以文献支撑的单体对象、特征、关系和类型判定构建可追溯的最小图谱；当前进行文献案例试表达，不是正式田野实证。",
  "design_authority": "类、属性、关系与断言结构均为本研究的建模提案；basisRefs说明建筑学依据，不声称原文作者提出这些图谱结构。",
  "classes": [
    {
      "id": "Dwelling",
      "label": "民居研究单元",
      "definition": "本轮单体分析的对象边界。可含明确归属的主屋、附属体与庭院；不以同姓、同一院落或同一照片自动合并独立住宅。",
      "basisRefs": [
        "NQD9DRI3:E2",
        "26QUPIXE:E3"
      ],
      "tier": "core"
    },
    {
      "id": "Space",
      "label": "空间单元",
      "definition": "可辨识、可命名或具有分析用途的空间范围，如厅堂、房间、廊、天井、院落。空间为空间范围，不等于构件或围护实体。",
      "basisRefs": [
        "NQD9DRI3:E7",
        "NQD9DRI3:E11",
        "92HEGM9S:E3"
      ],
      "tier": "core"
    },
    {
      "id": "Element",
      "label": "建筑实体部分",
      "definition": "可独立指认的体量、构造系统、构架或构件；用elementLevel区分体量/系统/构架/构件，按证据需要细化。",
      "basisRefs": [
        "26QUPIXE:E4",
        "83W7CJW2:E3",
        "NQD9DRI3:E14"
      ],
      "tier": "core"
    },
    {
      "id": "Representation",
      "label": "图纸或调查记录",
      "definition": "文献中的平面、剖面侧样、照片或表格记录。它是建筑的表述，不是建筑本身；无法确认建筑对应时仍可记录表内特征。",
      "basisRefs": [
        "83W7CJW2:E2",
        "ZWDJJE99:E5"
      ],
      "tier": "core"
    },
    {
      "id": "Place",
      "label": "地点或外部空间",
      "definition": "村落、地块、道路等外部接口，仅保存定位和解释单体所需关系。",
      "basisRefs": [
        "V5RJB5WJ:E1",
        "6TEACH2F:E2"
      ],
      "tier": "interface"
    },
    {
      "id": "TypeScheme",
      "label": "分类体系",
      "definition": "带来源、研究区域、分类维度与版本的一套判据；不同文献中的同名类型不默认同义。",
      "basisRefs": [
        "AR5L935U:E5",
        "NQD9DRI3:E3",
        "83W7CJW2:E4"
      ],
      "tier": "core"
    },
    {
      "id": "TypeConcept",
      "label": "类型概念",
      "definition": "某一体系内的类别或作者推辨原型；标明普通类别/原型，不把原型视为历史上实存的母体建筑。",
      "basisRefs": [
        "26QUPIXE:E3",
        "83W7CJW2:E4"
      ],
      "tier": "core"
    },
    {
      "id": "ChangeEvent",
      "label": "变化事件",
      "definition": "有时间或前后状态证据支持的加建、减建、用途改变等事件；类型图的变形操作不能直接生成历史事件。",
      "basisRefs": [
        "92HEGM9S:E6",
        "V5RJB5WJ:E2"
      ],
      "tier": "extension"
    },
    {
      "id": "GeometryRegion",
      "label": "三维或二维区域锚点",
      "definition": "绑定模型/图纸的文件版本、坐标系与区域标识；只预留接口，本轮无真实三维数据关联。",
      "basisRefs": [],
      "tier": "extension"
    }
  ],
