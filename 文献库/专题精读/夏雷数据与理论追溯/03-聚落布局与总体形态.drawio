<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-21T00:00:00.000Z" agent="Codex" version="32.4.1" type="device"><diagram name="聚落布局与总体形态" id="聚落布局与总体形态"><mxGraphModel dx="2360" dy="1580" grid="1" gridSize="10" page="0" pageWidth="2360" pageHeight="1580" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="03｜聚落布局与总体形态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=38;spacing=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="25" width="2260" height="70" /></mxCell><mxCell id="subtitle" value="从原有数据组出发，反向追问：描述什么 → 怎样提取 → 依据何在 → 如何复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=24;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="100" width="2260" height="55" /></mxCell><UserObject id="core" label="&lt;b&gt;用形态和关系解释民居分布&lt;/b&gt;&lt;br&gt;&lt;br&gt;LB组 · 34条&lt;br&gt;原编号可逐项回查" link="03-聚落布局与总体形态.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF1FA;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=27;spacing=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="650" width="350" height="205" /></mxCell></UserObject><mxCell id="b0" value="数据与特征" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF1FA;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="225" width="245" height="110" /></mxCell><UserObject id="c0" label="布局 L01—L10；村落基础、人口经济与用地 B01—B24作为同一阅读分支的背景材料。包括布局模式、建设用地与建筑密度、边界形状、人口与面积等。B组并不都具有形态理论的逐项依据。" link="03-聚落布局与总体形态.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="190" width="1390" height="190" /></mxCell></UserObject><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b0" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="280" /></Array></mxGeometry></mxCell><mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#516CAE;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#516CAE;labelBackgroundColor=#FFFFFF;" edge="1" source="b0" target="c0" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b1" value="识别与整理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF1FA;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="460" width="245" height="110" /></mxCell><UserObject id="c1" label="从平面肌理、道路及建筑组合识别总体布局；以形态类型归类；Boyce–Clark形状指数用边界到中心的射线长度派生计算；面积、人数与密度保留原始量及计算口径。" link="03-聚落布局与总体形态.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="425" width="1390" height="190" /></mxCell></UserObject><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b1" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="515" /></Array></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#516CAE;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#516CAE;labelBackgroundColor=#FFFFFF;" edge="1" source="b1" target="c1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b2" value="理论与方法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF1FA;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="695" width="245" height="110" /></mxCell><UserObject id="c2" label="K02 形态／类型支持形态分析、归类和编码（p.25—27）；K03 为结构关系的概念支撑；K10 是特定形状测度工具。人口经济项在此仅是背景与计算输入，不强行对应形态理论。" link="理论与方法解读卡.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="660" width="1390" height="190" /></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="750" /></Array></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#516CAE;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#516CAE;labelBackgroundColor=#FFFFFF;" edge="1" source="b2" target="c2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b3" value="资料从哪里来" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF1FA;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="930" width="245" height="110" /></mxCell><UserObject id="c3" label="S01影像规划、S05统计、S07图形及S11图纸分析；具体形状值在第三章展示。逐对象影像日期、分辨率与完整边界数据并未一一提供。" link="03-聚落布局与总体形态.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#516CAE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="895" width="1390" height="190" /></mxCell></UserObject><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b3" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="985" /></Array></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#516CAE;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#516CAE;labelBackgroundColor=#FFFFFF;" edge="1" source="b3" target="c3" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b4" value="我们怎样复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDF9;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1165" width="245" height="110" /></mxCell><UserObject id="c4" label="【优先试采】服务 B 村落与 C 组团：界定观察单元，记录建筑分布、排列、邻接、围合及道路关系。布局词汇可作候选，景宁类型与组团边界需用样本校订。" link="03-聚落布局与总体形态.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1130" width="1390" height="190" /></mxCell></UserObject><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b4" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="1220" /></Array></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" source="b4" target="c4" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="cross" value="跨章追溯；强弱见解读卡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=block;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="c1" target="c2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2260" y="520" /><mxPoint x="2260" y="755" /></Array></mxGeometry></mxCell><mxCell id="boundary" value="&lt;b&gt;边界提醒&lt;/b&gt;&lt;br&gt;&lt;br&gt;形状指数不是全部风貌的替代指标；作者32条射线是具体操作选择。数据库中的村落整体布局与本项目“民居组团”观察单元不可直接等同。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF5E7;strokeColor=#D2B184;fontColor=#25364A;fontFamily=Helvetica;fontSize=23;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1430" width="2250" height="135" /></mxCell><mxCell id="locator" value="原文印刷页：25、26、27、28、59、60、87、88、95、118、119；PDF页序＝印刷页＋17。灰线为阅读分组；紫虚线为整理者追溯／建议。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=20;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1340" width="2250" height="65" /></mxCell></root></mxGraphModel></diagram></mxfile>