<mxfile host="app.diagrams.net" modified="2026-10-21T00:00:00.000Z" agent="Codex" version="32.4.1" type="device"><diagram name="人文信息与解释线索" id="人文信息与解释线索"><mxGraphModel dx="2360" dy="1580" grid="1" gridSize="10" page="0" pageWidth="2360" pageHeight="1580" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="07｜人文信息与解释线索" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=38;spacing=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="25" width="2260" height="70" /></mxCell><mxCell id="subtitle" value="从原有数据组出发，反向追问：描述什么 → 怎样提取 → 依据何在 → 如何复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=24;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="100" width="2260" height="55" /></mxCell><UserObject id="core" label="&lt;b&gt;把文化线索落到具体空间&lt;/b&gt;&lt;br&gt;&lt;br&gt;U组 · 18条&lt;br&gt;原编号可逐项回查" link="07-人文信息与解释线索.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EBF5F2;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=27;spacing=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="650" width="350" height="205" /></mxCell></UserObject><mxCell id="b0" value="数据与特征" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EBF5F2;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="225" width="245" height="110" /></mxCell><UserObject id="c0" label="人文 U01—U18。包括耕作、传统手工艺、居住习惯、邻里／社区活动、饮食、宗教祭祀、村规、传说、节庆、语言服饰与民间艺术等。" link="07-人文信息与解释线索.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="190" width="1390" height="190" /></mxCell></UserObject><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b0" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="280" /></Array></mxGeometry></mxCell><mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D8986;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4D8986;labelBackgroundColor=#FFFFFF;" edge="1" source="b0" target="c0" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b1" value="识别与整理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EBF5F2;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="460" width="245" height="110" /></mxCell><UserObject id="c1" label="图4-2以文本、图案、元素、结构、勘察感知、入户访谈等作识别；表4-2给人文编码；图4-10将文档与图片整理成人文框架。无法简写的内容保留文字描述。" link="07-人文信息与解释线索.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="425" width="1390" height="190" /></mxCell></UserObject><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b1" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="515" /></Array></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D8986;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4D8986;labelBackgroundColor=#FFFFFF;" edge="1" source="b1" target="c1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b2" value="理论与方法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EBF5F2;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="695" width="245" height="110" /></mxCell><UserObject id="c2" label="K04场所文脉说明时间、空间、活动及社会文化联系；K06识别模式把地域文化纳入识别；K08村落景观分类文献参与框架。人文三分或各字段并非舒尔茨原著直接给出。" link="理论与方法解读卡.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="660" width="1390" height="190" /></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="750" /></Array></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D8986;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4D8986;labelBackgroundColor=#FFFFFF;" edge="1" source="b2" target="c2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b3" value="资料从哪里来" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EBF5F2;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="930" width="245" height="110" /></mxCell><UserObject id="c3" label="S06地方志等文本、S04问卷访谈、S11政府／村务资料分析。类级渠道不能说明每项已现场访谈，也不能把作者转述的文化概况当一手田野证词。" link="07-人文信息与解释线索.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4D8986;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="895" width="1390" height="190" /></mxCell></UserObject><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b3" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="985" /></Array></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4D8986;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4D8986;labelBackgroundColor=#FFFFFF;" edge="1" source="b3" target="c3" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b4" value="我们怎样复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDF9;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1165" width="245" height="110" /></mxCell><UserObject id="c4" label="【围绕民居选择采集】对接 F：工艺—构件、活动—场所、居住—平面、历史—改建阶段。以上连接是本研究建议，须补具体对象、说话人／文献与时间，不能当夏雷已建立的关系字段。" link="07-人文信息与解释线索.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1130" width="1390" height="190" /></mxCell></UserObject><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b4" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="1220" /></Array></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" source="b4" target="c4" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="cross" value="跨章追溯；强弱见解读卡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=block;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="c1" target="c2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2260" y="520" /><mxPoint x="2260" y="755" /></Array></mxGeometry></mxCell><mxCell id="boundary" value="&lt;b&gt;边界提醒&lt;/b&gt;&lt;br&gt;&lt;br&gt;奇人异事在p.91要求重新分析筛选，不能直接认作稳定基础字段。民族标签不自动解释屋顶、院落或装饰；需要具体来源及比较证据。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF5E7;strokeColor=#D2B184;fontColor=#25364A;fontFamily=Helvetica;fontSize=23;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1430" width="2250" height="135" /></mxCell><mxCell id="locator" value="原文印刷页：29、31、32、84、85、86、87、88、89、91、96、119；PDF页序＝印刷页＋17。灰线为阅读分组；紫虚线为整理者追溯／建议。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=20;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1340" width="2250" height="65" /></mxCell></root></mxGraphModel></diagram></mxfile>