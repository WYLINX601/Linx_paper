nt x="440" y="752" /><mxPoint x="440" y="515" /></Array></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9074AE;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#9074AE;labelBackgroundColor=#FFFFFF;" edge="1" source="b1" target="c1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b2" value="理论与方法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EEF8;strokeColor=#9074AE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="695" width="245" height="110" /></mxCell><UserObject id="c2" label="K02 空间形态与K03关系视角是框架；K06 作者识别模式直接点名这些对象；K05环境认知关联人的感受。不能由几何比例单独推出满意度。" link="理论与方法解读卡.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#9074AE;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="660" width="1390" height="190" /></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="750" /></Array></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9074AE;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#9074AE;labelBackgroundColor=#FFFFFF;" edge="1" source="b2" target="c2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b3" value="资料从哪里来" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EEF8;strokeColor=#9074AE;fontColor=#25364A;fontFamily=Helvetica;fontSize