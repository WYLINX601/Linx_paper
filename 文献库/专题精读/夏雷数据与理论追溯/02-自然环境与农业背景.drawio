<mxfile host="app.diagrams.net" modified="2026-10-21T00:00:00.000Z" agent="Codex" version="32.4.1" type="device"><diagram name="自然环境与农业背景" id="自然环境与农业背景"><mxGraphModel dx="2360" dy="1580" grid="1" gridSize="10" page="0" pageWidth="2360" pageHeight="1580" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="02｜自然环境与农业背景" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=38;spacing=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="25" width="2260" height="70" /></mxCell><mxCell id="subtitle" value="从原有数据组出发，反向追问：描述什么 → 怎样提取 → 依据何在 → 如何复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=24;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="100" width="2260" height="55" /></mxCell><UserObject id="core" label="&lt;b&gt;保留解释民居的环境关系&lt;/b&gt;&lt;br&gt;&lt;br&gt;NAGY组 · 62条&lt;br&gt;原编号可逐项回查" link="02-自然环境与农业背景.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECF5EB;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=27;spacing=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="650" width="350" height="205" /></mxCell></UserObject><mxCell id="b0" value="数据与特征" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECF5EB;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="225" width="245" height="110" /></mxCell><UserObject id="c0" label="自然 N01—N23，农业 A01—A20，跨空间计算量 G01—G10，区域年鉴与土地背景 Y01—Y09。涉及地形气候、山水位置、植被、水质、农业用地与设施，以及面积和比率计算。" link="02-自然环境与农业背景.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="190" width="1390" height="190" /></mxCell></UserObject><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b0" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="280" /></Array></mxGeometry></mxCell><mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C8B55;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4C8B55;labelBackgroundColor=#FFFFFF;" edge="1" source="b0" target="c0" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b1" value="识别与整理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECF5EB;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="460" width="245" height="110" /></mxCell><UserObject id="c1" label="自然要素识别编码与关系描述；图4-7、4-8构建分类框架；第五章将部分面积计算为覆盖率、比例并赋分。G含跨村落、街道、庭院的计算输入，不能都视为自然原始实测。" link="02-自然环境与农业背景.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="425" width="1390" height="190" /></mxCell></UserObject><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b1" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="515" /></Array></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C8B55;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4C8B55;labelBackgroundColor=#FFFFFF;" edge="1" source="b1" target="c1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b2" value="理论与方法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECF5EB;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="695" width="245" height="110" /></mxCell><UserObject id="c2" label="K01 系统科学为整体环境关系提供框架；K03 拓扑提供聚落—环境关系的概念视角；K08 解释分类与筛选。具体生态评价另追K09的标准，不能由拓扑推导水质标准。" link="理论与方法解读卡.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="660" width="1390" height="190" /></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="750" /></Array></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C8B55;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4C8B55;labelBackgroundColor=#FFFFFF;" edge="1" source="b2" target="c2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b3" value="资料从哪里来" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECF5EB;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="930" width="245" height="110" /></mxCell><UserObject id="c3" label="S03现场、S05统计、S06—S07文本与图件、S10—S11部门资料是相应类别渠道；Y仅对应表2-1五本2018年鉴，不能当28村全部数据的直接来源。" link="02-自然环境与农业背景.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#4C8B55;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="895" width="1390" height="190" /></mxCell></UserObject><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b3" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="985" /></Array></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C8B55;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#4C8B55;labelBackgroundColor=#FFFFFF;" edge="1" source="b3" target="c3" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b4" value="我们怎样复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDF9;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1165" width="245" height="110" /></mxCell><UserObject id="c4" label="【选择采集】优先地形、水系、朝向及与民居分布／建造的联系，服务本项目 B 村落、C 组团、F 解释资料；农业、生态绩效仅在能解释具体民居特征时深化。" link="02-自然环境与农业背景.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1130" width="1390" height="190" /></mxCell></UserObject><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b4" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="1220" /></Array></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" source="b4" target="c4" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="cross" value="跨章追溯；强弱见解读卡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=block;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="c1" target="c2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2260" y="520" /><mxPoint x="2260" y="755" /></Array></mxGeometry></mxCell><mxCell id="boundary" value="&lt;b&gt;边界提醒&lt;/b&gt;&lt;br&gt;&lt;br&gt;分类阶段不同：p.89筛选四类；p.94把农业归自然但保留独立图4-8；p.98仍有农业数据表。三类概念、四类筛选与多张数据表不应混为一层。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF5E7;strokeColor=#D2B184;fontColor=#25364A;fontFamily=Helvetica;fontSize=23;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1430" width="2250" height="135" /></mxCell><mxCell id="locator" value="原文印刷页：24、28、31、32、37、85、89、90、91、94、98、117、118、119；PDF页序＝印刷页＋17。灰线为阅读分组；紫虚线为整理者追溯／建议。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=20;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1340" width="2250" height="65" /></mxCell></root></mxGraphModel></diagram></mxfile>