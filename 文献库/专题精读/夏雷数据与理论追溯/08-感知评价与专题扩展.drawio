<mxfile host="app.diagrams.net" modified="2026-10-21T00:00:00.000Z" agent="Codex" version="32.4.1" type="device"><diagram name="感知评价与专题扩展" id="感知评价与专题扩展"><mxGraphModel dx="2360" dy="1580" grid="1" gridSize="10" page="0" pageWidth="2360" pageHeight="1580" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="08｜感知评价与专题扩展" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=38;spacing=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="25" width="2260" height="70" /></mxCell><mxCell id="subtitle" value="从原有数据组出发，反向追问：描述什么 → 怎样提取 → 依据何在 → 如何复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=24;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="100" width="2260" height="55" /></mxCell><UserObject id="core" label="&lt;b&gt;区分描述、评价与专题目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;QEDZV组 · 145条&lt;br&gt;原编号可逐项回查" link="08-感知评价与专题扩展.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EFF2F6;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=27;spacing=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="650" width="350" height="205" /></mxCell></UserObject><mxCell id="b0" value="数据与特征" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EFF2F6;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="225" width="245" height="110" /></mxCell><UserObject id="c0" label="问卷／感知 Q01—Q15、专家与分类评价 E01—E13、标准 D01—D32、专题 Z01—Z45与绿色建筑 V01—V40。汇集在此是阅读导航，不是作者单一数据类别；Z14等同时涉及核心表。" link="08-感知评价与专题扩展.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="190" width="1390" height="190" /></mxCell></UserObject><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b0" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="280" /></Array></mxGeometry></mxCell><mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6A778C;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#6A778C;labelBackgroundColor=#FFFFFF;" edge="1" source="b0" target="c0" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b1" value="识别与整理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EFF2F6;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="460" width="245" height="110" /></mxCell><UserObject id="c1" label="基础信息筛选（第四章）与评价指标筛选（第五章）分开；居民五级满意度、调查者赋分、客观统计亦分开。32位专家筛指标；ANP权重问卷50发、47回、45有效。专题另做行为地图和绿色建筑／住宅扩展。" link="08-感知评价与专题扩展.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="425" width="1390" height="190" /></mxCell></UserObject><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b1" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="515" /></Array></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6A778C;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#6A778C;labelBackgroundColor=#FFFFFF;" edge="1" source="b1" target="c1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b2" value="理论与方法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EFF2F6;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="695" width="245" height="110" /></mxCell><UserObject id="c2" label="K05 环境认知支撑主观评价方向；K08基础筛选；K09标准与评价组织；K11权重及比较方法；K12专题。评价用途不能反推全部基础字段都是评价指标。" link="理论与方法解读卡.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="660" width="1390" height="190" /></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="750" /></Array></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6A778C;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#6A778C;labelBackgroundColor=#FFFFFF;" edge="1" source="b2" target="c2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b3" value="资料从哪里来" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EFF2F6;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="930" width="245" height="110" /></mxCell><UserObject id="c3" label="S12居民、S13调查者、S14指标筛选专家、S15权重专家、S16标准与研究、S17专题。标准／文献是选择和赋分依据，不是实测资料提供者。" link="08-感知评价与专题扩展.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#6A778C;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="895" width="1390" height="190" /></mxCell></UserObject><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b3" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="985" /></Array></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6A778C;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#6A778C;labelBackgroundColor=#FFFFFF;" edge="1" source="b3" target="c3" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b4" value="我们怎样复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDF9;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1165" width="245" height="110" /></mxCell><UserObject id="c4" label="【暂缓整套移植】当前先做民居描述、语义与空间对应；需要感知问题时再设计问卷。可借评价与事实分开、原始值与派生分数并存；不沿用作者权重、样本量、评分阈值。" link="08-感知评价与专题扩展.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1130" width="1390" height="190" /></mxCell></UserObject><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b4" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="1220" /></Array></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" source="b4" target="c4" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="cross" value="跨章追溯；强弱见解读卡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=block;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="c1" target="c2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2260" y="520" /><mxPoint x="2260" y="755" /></Array></mxGeometry></mxCell><mxCell id="boundary" value="&lt;b&gt;边界提醒&lt;/b&gt;&lt;br&gt;&lt;br&gt;专题不代表28村统一采全；冬季室温等可见字段不能证明已有仪器实测。描述项如屋顶色彩、铺装材料、街道弯度可统计，不必强行评分（p.121）。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF5E7;strokeColor=#D2B184;fontColor=#25364A;fontFamily=Helvetica;fontSize=23;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1430" width="2250" height="135" /></mxCell><mxCell id="locator" value="原文印刷页：30、31、89、90、91、117、119、120、121、126、129、131、132、183、188、189、193、194、196；PDF页序＝印刷页＋17。灰线为阅读分组；紫虚线为整理者追溯／建议。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=20;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1340" width="2250" height="65" /></mxCell></root></mxGraphModel></diagram></mxfile>