<mxfile host="app.diagrams.net" modified="2026-10-21T00:00:00.000Z" agent="Codex" version="32.4.1" type="device"><diagram name="前期组织与证据管理" id="前期组织与证据管理"><mxGraphModel dx="2360" dy="1580" grid="1" gridSize="10" page="0" pageWidth="2360" pageHeight="1580" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="01｜前期组织与证据管理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=38;spacing=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="25" width="2260" height="70" /></mxCell><mxCell id="subtitle" value="从原有数据组出发，反向追问：描述什么 → 怎样提取 → 依据何在 → 如何复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=24;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="100" width="2260" height="55" /></mxCell><UserObject id="core" label="&lt;b&gt;对象编号、来源与原件对应&lt;/b&gt;&lt;br&gt;&lt;br&gt;PRJ组 · 45条&lt;br&gt;原编号可逐项回查" link="01-前期组织与证据管理.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F4F5;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=27;spacing=18;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="650" width="350" height="205" /></mxCell></UserObject><mxCell id="b0" value="数据与特征" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F4F5;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="225" width="245" height="110" /></mxCell><UserObject id="c0" label="准备工作 P01—P19；原始资料 R01—R23；资料身份与录入信息 J01—J03。包括研究范围、典型样本选择、预收集、踏勘、问卷、资料格式、唯一编号、质量核对与更新要求。" link="01-前期组织与证据管理.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="190" width="1390" height="190" /></mxCell></UserObject><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b0" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="280" /></Array></mxGeometry></mxCell><mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#267E88;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#267E88;labelBackgroundColor=#FFFFFF;" edge="1" source="b0" target="c0" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b1" value="识别与整理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F4F5;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="460" width="245" height="110" /></mxCell><UserObject id="c1" label="先收集已有资料并判断难度，再踏勘和补充；统计、文档、图形、问卷及感知记录分别整理；对象编号把建筑、庭院、道路、问卷与图形对应起来；提取结构化数据后保留原件。" link="01-前期组织与证据管理.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="425" width="1390" height="190" /></mxCell></UserObject><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b1" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="515" /></Array></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#267E88;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#267E88;labelBackgroundColor=#FFFFFF;" edge="1" source="b1" target="c1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b2" value="理论与方法" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F4F5;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="695" width="245" height="110" /></mxCell><UserObject id="c2" label="K01 系统科学提供整体与结构视角（框架级）；K07 是作者的信息抽象与整理设计（直接操作依据）。不能把唯一编号说成一般系统论直接规定的字段。" link="理论与方法解读卡.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="660" width="1390" height="190" /></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="750" /></Array></mxGeometry></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#267E88;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#267E88;labelBackgroundColor=#FFFFFF;" edge="1" source="b2" target="c2" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b3" value="资料从哪里来" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F4F5;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="930" width="245" height="110" /></mxCell><UserObject id="c3" label="S01—S09：地方政府提供影像与规划图，部门走访、现场记录、居民问卷；S18仅为区域背景年鉴。P14—P19中不少是质量与维护要求，不能升格为逐项已实施。" link="01-前期组织与证据管理.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#267E88;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="895" width="1390" height="190" /></mxCell></UserObject><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b3" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="985" /></Array></mxGeometry></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#267E88;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#267E88;labelBackgroundColor=#FFFFFF;" edge="1" source="b3" target="c3" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="b4" value="我们怎样复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3EDF9;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1165" width="245" height="110" /></mxCell><UserObject id="c4" label="【先复用工作方法】对象编号、资料编号、来源／时点／页码、原件与提取值相互对应；衔接本项目 A 前期、G 影像、I 核验。对象编号与资料编号应区分。" link="01-前期组织与证据管理.md"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B6AAF;fontColor=#25364A;fontFamily=Helvetica;fontSize=25;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1130" width="1390" height="190" /></mxCell></UserObject><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BCC6D2;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#BCC6D2;labelBackgroundColor=#FFFFFF;" edge="1" source="core" target="b4" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="440" y="752" /><mxPoint x="440" y="1220" /></Array></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=none;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" source="b4" target="c4" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="cross" value="跨章追溯；强弱见解读卡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B6AAF;strokeWidth=2;endArrow=block;fontFamily=Helvetica;fontSize=16;fontColor=#8B6AAF;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="c1" target="c2" parent="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2260" y="520" /><mxPoint x="2260" y="755" /></Array></mxGeometry></mxCell><mxCell id="boundary" value="&lt;b&gt;边界提醒&lt;/b&gt;&lt;br&gt;&lt;br&gt;原文由124村踏勘至16村详查，后扩为28村；这是作者样本过程，不能变成景宁所需样本数。关系型表间编号也不等于三维空间区域绑定。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF5E7;strokeColor=#D2B184;fontColor=#25364A;fontFamily=Helvetica;fontSize=23;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1430" width="2250" height="135" /></mxCell><mxCell id="locator" value="原文印刷页：54、55、56、80、81、82、83、93、98、100、101、108、109；PDF页序＝印刷页＋17。灰线为阅读分组；紫虚线为整理者追溯／建议。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=none;fontColor=#25364A;fontFamily=Helvetica;fontSize=20;spacing=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1340" width="2250" height="65" /></mxCell></root></mxGraphModel></diagram></mxfile>