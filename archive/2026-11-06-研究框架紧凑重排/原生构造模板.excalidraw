      "isDeleted": false,
      "boundElements": [],
      "updated": 1793897314613,
      "created": 1793883560396,
      "link": null,
      "locked": false,
      "text": "研究推进与论文呈现相互对应，但不混为同一\n层级。",
      "rawText": "研究推进与论文呈现相互对应，但不混为同一\n层级。",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "研究推进与论文呈现相互对应，但不混为同一\n层级。",
      "autoResize": true,
      "lineHeight": 1.15,
      "hasTextLink": false
    },
    {
      "id": "dIEaWH8g",
      "type": "text",
      "x": 178,
      "y": 1514.8,
      "width": 384,
      "height": 18.4,
      "angle": 0,
      "strokeColor": "#565656",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4E",
      "roundness": null,
      "seed": 1115739759,
      "version": 10,
      "versionNonce": 30701399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793897314613,
      "created": 1793883560397,
      "link": null,
      "locked": false,
      "text": "地域文化用于有据解释，不由外观直接推定文化成因。",
      "rawText": "地域文化用于有据解释，不由外观直接推定文化成因。",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "地域文化用于有据解释，不由外观直接推定文化成因。",
      "autoResize": true,
      "lineHeight": 1.15,
      "hasTextLink": false
    },
    {
      "id": "hx16abE7",
      "type": "text",
      "x": 786,
      "y": 1514.8,
      "width": 448,
      "height": 18.4,
      "angle": 0,
      "strokeColor": "#565656",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4F",
      "roundness": null,
      "seed": 1131498497,
      "version": 10,
      "versionNonce": 197839911,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793897314613,
      "created": 1793883560397,
      "link": null,
      "locked": false,
      "text": "列入比较不等于采用；感知仅作理论背景，文化解释有据才用。",
      "rawText": "列入比较不等于采用；感知仅作理论背景，文化解释有据才用。",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "列入比较不等于采用；感知仅作理论背景，文化解释有据才用。",
      "autoResize": true,
      "lineHeight": 1.15,
      "hasTextLink": false
    },
    {
