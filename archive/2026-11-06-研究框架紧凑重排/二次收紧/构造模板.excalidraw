      "isDeleted": false,
      "boundElements": [],
      "updated": 1793923837889,
      "created": 1793883560397,
      "link": null,
      "locked": false,
      "text": "地域文化用于有据解释，不由外观直接推定文化成因。",
      "rawText": "地域文化用于有据解释，不由外观直接推定文化成因。",
      "fontSize": 16,
      "baseFontSize": null,
