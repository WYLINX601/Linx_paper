  <diagram id="uav-route" name="无人机倾斜摄影技术路线">
    <mxGraphModel dx="1540" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1220" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;无人机倾斜摄影技术路线&lt;/b&gt; · 讨论稿" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=28;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="&lt;b&gt;风貌指标需求与多尺度试调查&lt;/b&gt;&lt;br&gt;明确对象、视角、尺度依据及检查要求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6383A4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="800" height="90" as="geometry" />
        </mxCell>
        <mxCell id="uav" value="&lt;b&gt;村落／组团：整体倾斜摄影&lt;/b&gt;&lt;br&gt;屋顶、建筑分布、体量与空间关系&lt;br&gt;按地形和遮挡安排多角度航拍" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6383A4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ground" value="&lt;b&gt;重点单体：地面补拍与调查&lt;/b&gt;&lt;br&gt;檐下、窄巷、立面及可见构件&lt;br&gt;必要实测；保留原始照片" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6383A4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="230" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;空间基准与独立检查资料&lt;/b&gt;&lt;br&gt;坐标／已知尺度参与约束&lt;br&gt;另留检查点或检查尺寸" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6383A4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="230" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="recon" value="&lt;b&gt;摄影测量重建与空地资料衔接&lt;/b&gt;&lt;br&gt;SfM → MVS → 点云／网格与纹理&lt;br&gt;统一基准；保留原始数据、版本及处理记录" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6383A4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="430" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="laser" value="&lt;b&gt;必要时补充勘测&lt;/b&gt;&lt;br&gt;激光扫描等按精度需求与设备条件选用&lt;br&gt;不预设全村扫描" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C969E;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=20;align=center;verticalAlign=middle;spacing=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;按目标用途检查&lt;/b&gt;&lt;br&gt;可见性 · 几何 · 来源 · 工时" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#B79A58;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="repair" value="&lt;b&gt;信息或几何不足&lt;/b&gt;&lt;br&gt;补拍／实测后重新处理与检查&lt;br&gt;无法补足：标记缺失或调整字段" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#B79A58;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
